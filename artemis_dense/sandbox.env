# sandbox.env: isolated test environment for Artemis (one dense LLM).
# Everything run with this file is UNTRUSTED OUTPUT UNDER TEST. Nothing here
# is a product or service until it passes tests and is promoted with approval.
# Holds no secrets. Never add keys, tokens or passwords to this file.

# --- Identity / marker ---
ARTEMIS_ENV=sandbox
ARTEMIS_UNTRUSTED=1
ARTEMIS_SANDBOX_LABEL="UNTRUSTED OUTPUT UNDER TEST - NOT PRODUCTION"
ARTEMIS_PROMOTION_REQUIRES_APPROVAL=1

# --- Isolated paths (never point these at real data) ---
ARTEMIS_SANDBOX_ROOT=/tmp/artemis-sandbox
ARTEMIS_WORKDIR=${ARTEMIS_SANDBOX_ROOT}/work
ARTEMIS_CHECKPOINT_DIR=${ARTEMIS_SANDBOX_ROOT}/checkpoints
ARTEMIS_DATA_DIR=${ARTEMIS_SANDBOX_ROOT}/data
ARTEMIS_LOG_DIR=${ARTEMIS_SANDBOX_ROOT}/logs
ARTEMIS_TMPDIR=${ARTEMIS_SANDBOX_ROOT}/tmp
HOME=${ARTEMIS_SANDBOX_ROOT}/home
TMPDIR=${ARTEMIS_TMPDIR}
# Production paths are read-only or denied inside the sandbox
ARTEMIS_PROD_PATHS_DENY=/workspace,/home/box,/cursor/stores
ARTEMIS_READONLY_MOUNTS=

# --- No live services ---
ARTEMIS_NETWORK=off
ARTEMIS_ALLOW_OUTBOUND=0
ARTEMIS_API_BIND=127.0.0.1
ARTEMIS_API_PORT=0
ARTEMIS_A2A_MODE=loopback
ARTEMIS_A2A_ALLOW_EXTERNAL=0
ARTEMIS_ALLOW_PUSH=0
ARTEMIS_ALLOW_PAYMENTS=0
ARTEMIS_ALLOW_EMAIL=0
ARTEMIS_ALLOW_DEPLOY=0
ARTEMIS_GPU_RENTAL=0
HTTP_PROXY=http://127.0.0.1:9
HTTPS_PROXY=http://127.0.0.1:9
NO_PROXY=127.0.0.1,localhost

# --- Model / runtime ---
ARTEMIS_MODEL_SIZE=tiny
ARTEMIS_DEVICE=cpu
ARTEMIS_SEED=1234
ARTEMIS_DETERMINISTIC=1

# --- Resource limits ---
ARTEMIS_TIMEOUT_SECONDS=300
ARTEMIS_MAX_CPU_THREADS=2
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
ARTEMIS_MAX_MEMORY_MB=2048
ARTEMIS_MAX_DISK_MB=1024
ARTEMIS_MAX_PROCESSES=32
ARTEMIS_MAX_OPEN_FILES=256
ARTEMIS_MAX_OUTPUT_BYTES=1048576

# --- Audit / cleanup ---
ARTEMIS_AUDIT_LOG=${ARTEMIS_LOG_DIR}/audit.jsonl
ARTEMIS_WIPE_ON_EXIT=1
