# custom.env: configuration for Artemis's custom Constitutional AI system.
# Holds no secrets.
ARTEMIS_CAI_CONSTITUTION=artemis_dense/custom_constitutional_env/constitution.yaml
ARTEMIS_CAI_SANDBOX_ENV=artemis_dense/sandbox.env
ARTEMIS_CAI_MODE=block            # block = violations stop promotion; flag = warn only
ARTEMIS_CAI_MAX_FLAGS=3           # this many flag-level hits also blocks promotion
ARTEMIS_CAI_BLOCK_SEVERITIES=block
ARTEMIS_CAI_REQUIRE_SANDBOX=1
ARTEMIS_CAI_LOG=/tmp/artemis-sandbox/logs/constitution.jsonl
ARTEMIS_CAI_LOG_LEVEL=info
ARTEMIS_CAI_REDACT_IN_LOGS=1      # never write matched secret text to logs
