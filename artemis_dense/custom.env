# custom.env: configuration for Artemis's custom Constitutional AI system.
# Holds no secrets.
ARTEMIS_CAI_CONSTITUTION=artemis_dense/custom_constitutional_env/constitution.yaml
ARTEMIS_CAI_SANDBOX_ENV=artemis_dense/sandbox.env

# Default: loose. Warn and log, never block.
ARTEMIS_CAI_MODE=warn
ARTEMIS_CAI_STRICTNESS=0.2          # low strictness (0 = loosest, 1 = strictest)

# Conditional strict mode: off until escalation triggers it
STRICT_MODE=false
ARTEMIS_CAI_ESCALATE_MAX_WARNINGS=3     # more than this many warnings in one session triggers strict
ARTEMIS_CAI_ESCALATE_ON_CRITICAL=1      # any single critical violation triggers strict
ARTEMIS_CAI_ESCALATE_ON_SELF_MODIFY=1   # touching the constitution or sandbox triggers strict
ARTEMIS_CAI_STRICT_REQUIRES_HUMAN=1     # strict blocks promotion until a human approves resuming

# Monitoring
ARTEMIS_CAI_LOG_DIR=/tmp/artemis-sandbox/logs/constitution
ARTEMIS_CAI_LOG=${ARTEMIS_CAI_LOG_DIR}/checks.jsonl
ARTEMIS_CAI_ALERTS_ENABLED=1
ARTEMIS_CAI_ALERT_FILE=${ARTEMIS_CAI_LOG_DIR}/alerts.jsonl
ARTEMIS_CAI_DASHBOARD=${ARTEMIS_CAI_LOG_DIR}/dashboard.md
ARTEMIS_CAI_RETENTION_DAYS=30
ARTEMIS_CAI_TRIGGER_SNIPPET_CHARS=200   # how much of the triggering output to keep
ARTEMIS_CAI_REDACT_IN_LOGS=1            # secrets in triggers are replaced with [REDACTED]
